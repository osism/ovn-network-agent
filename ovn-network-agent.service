[Unit]
Description=OVN Network Agent — Real-time Floating IP route synchronization via OVN
Documentation=https://github.com/osism/ovn-network-agent

# FRR is a soft dependency, intentionally Wants= rather than Requires=.
# Requires= propagates FRR's stop to the agent, so every FRR package
# upgrade or restart would drain this node and fail its gateways over —
# needless churn. The agent degrades gracefully when vtysh is
# unavailable (route writes are logged and retried on the next reconcile,
# default 60s) and FRR may run outside the host package manager entirely
# (e.g. containerized), where no frr.service unit exists. Wants= keeps the
# ordering below without coupling the agent's lifecycle to FRR's.
Wants=frr.service
After=frr.service

# Soft dependencies — agent needs these but they may be provided by
# different unit names (e.g. native packages vs Kolla containers).
# Using Wants= so the agent can still be enabled on systems where
# these unit names don't exist.
Wants=network-online.target
Wants=kolla-openvswitch_vswitchd-container.service
Wants=kolla-ovn_controller-container.service

# After= ensures correct ordering for both start AND stop:
#  - Start: agent starts after these services are up
#  - Stop: agent stops before these services go down (drain completes first)
After=network-online.target
After=kolla-openvswitch_vswitchd-container.service
After=kolla-ovn_controller-container.service

# Cap restart storms on persistent fatal errors (e.g. getHostname failure):
# allow at most 10 restarts within 120s before systemd marks the unit failed.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/ovn-network-agent --config /etc/ovn-network-agent/config.yaml
Restart=always
RestartSec=5

# Allow drain (default 60s, see DrainTimeout in config.go) + cleanup margin
# (removeAllRoutes, RemoveOVSFlows, RemoveManagedNBEntries) before SIGKILL.
# Must be longer than the configured drain timeout.
TimeoutStopSec=120

# Environment overrides (optional, takes precedence over config file)
EnvironmentFile=-/etc/default/ovn-network-agent

# Security hardening
NoNewPrivileges=no
ProtectSystem=false
# Needs root for netlink route manipulation and vtysh access
# Consider CAP_NET_ADMIN + CAP_NET_RAW if running as non-root
#User=root
#AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ovn-network-agent

[Install]
WantedBy=multi-user.target
